{
  "name": "careconnect-electron-react",
  "private": true,
  "version": "1.0.0",
  "description": "CareConnect desktop application built with Electron, React and Vite",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on http://127.0.0.1:5173 && cross-env CARECONNECT_DEV=1 electron .\"",
    "dev:web": "vite",
    "dev:electron": "cross-env CARECONNECT_DEV=1 electron .",
    "build": "vite build",
    "start": "npm run build && electron .",
    "preview": "vite preview",
    "dist": "npm run build && electron-builder",
    "lint": "eslint . --max-warnings=0",
    "check": "npm run lint && npm run test:all && npm run build",
    "dist:win": "npm run check && electron-builder --win nsis",
    "pack:win": "npm run build && electron-builder --win --dir",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:ci": "jest --runInBand --coverage",
    "test:unit": "jest",
    "test:integration": "jest --config jest.integration.config.cjs --runInBand",
    "test:all": "npm run test:unit -- --runInBand && npm run test:integration",
    "test:integration:coverage": "jest --config jest.integration.config.cjs --runInBand --coverage"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@babel/preset-env": "^7.26.0",
    "@babel/preset-react": "^7.25.9",
    "@eslint/js": "^9.17.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@vitejs/plugin-react": "^4.3.4",
    "babel-jest": "^29.7.0",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^38.2.0",
    "electron-builder": "^25.1.8",
    "eslint": "^9.17.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.14.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "vite": "^5.4.11",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.careconnect.desktop",
    "productName": "CareConnect",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "CareConnect-Setup-${version}-${arch}.${ext}"
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage"
    },
    "asar": true,
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "CareConnect",
      "uninstallDisplayName": "CareConnect"
    }
  }
}
